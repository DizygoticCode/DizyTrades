# Copy to .env.local for local development. Never commit real values.
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=.data
LIVE_TRADING_ENABLED=false
PUBLIC_SIGNUP_ENABLED=true
LEGACY_AUTH_FALLBACK_ENABLED=true
MEXC_FUTURES_REST_BASE_URL=https://api.mexc.com
MEXC_FUTURES_WS_URL=wss://contract.mexc.com/edge

# Owner read-only Account Companion. Keep disabled until a server-side MEXC key
# has Account-read and Trade-read enabled with every write permission disabled.
OWNER_MEXC_ACCOUNT_COMPANION_ENABLED=false
OWNER_MEXC_READONLY_API_KEY=
OWNER_MEXC_READONLY_API_SECRET=
# Required exact value when enabling:
# account-read+trade-read;no-write/v1
OWNER_MEXC_READONLY_PERMISSION_ATTESTATION=

DIZYFLOW_LOW_MEMORY_MODE=true
DIZYFLOW_DEPTH_TRANSPORT=ws
MEXC_DEPTH_POLL_MS=2000
DIZYFLOW_HISTORY_MINUTES=5
DIZYFLOW_HISTORY_SAMPLE_MS=2000
DIZYFLOW_MAX_HISTORY_SAMPLES=150
DIZYFLOW_MAX_LEVELS_PER_SIDE=100
DIZYFLOW_MAX_COLLECTORS=2
DIZYFLOW_COLLECTOR_IDLE_MS=30000
DIZYFLOW_MAX_HEATMAP_RECORDS=20000
DIZYFLOW_HEATMAP_RETENTION_MINUTES=360
DIZYFLOW_HEATMAP_SAMPLE_MS=5000
DIZYFLOW_HEATMAP_MAX_MEMORY_RECORDS=20000
DIZYFLOW_HEATMAP_MAX_DISK_MB=64
DIZYFLOW_ARCHIVE_SYMBOLS=BTC_USDT
ALLOW_TEST_PLAINTEXT_PASSWORDS=false

ROB_NAME=Rob
ROB_EMAIL=rob@example.com
ROB_PASSWORD_HASH=generated-salt:generated-scrypt-hash
ROB_PASSWORD=

FRIEND_NAME=Nick
FRIEND_EMAIL=friend@example.com
FRIEND_PASSWORD_HASH=generated-salt:generated-scrypt-hash
FRIEND_PASSWORD=
DEXSCREENER_API_URL=https://api.dexscreener.com
GECKOTERMINAL_API_URL=https://api.geckoterminal.com/api/v2
# Optional only for a documented CoinGecko/GeckoTerminal plan; server-side.
GECKOTERMINAL_API_KEY=
