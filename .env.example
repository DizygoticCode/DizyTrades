# Copy to .env.local for local development. Never commit real values.
SESSION_SECRET=replace-with-at-least-32-random-characters
DATA_DIR=.data
LIVE_TRADING_ENABLED=false
PUBLIC_SIGNUP_ENABLED=true
LEGACY_AUTH_FALLBACK_ENABLED=true
MEXC_FUTURES_REST_BASE_URL=https://api.mexc.com
DIZYFLOW_LOW_MEMORY_MODE=true
DIZYFLOW_DEPTH_TRANSPORT=rest
MEXC_DEPTH_POLL_MS=2000
DIZYFLOW_HISTORY_MINUTES=5
DIZYFLOW_HISTORY_SAMPLE_MS=2000
DIZYFLOW_MAX_HISTORY_SAMPLES=150
DIZYFLOW_MAX_LEVELS_PER_SIDE=100
DIZYFLOW_MAX_COLLECTORS=2
DIZYFLOW_COLLECTOR_IDLE_MS=30000
DIZYFLOW_MAX_HEATMAP_RECORDS=20000
DIZYFLOW_HEATMAP_RETENTION_MINUTES=360
DIZYFLOW_HEATMAP_SAMPLE_MS=5000
DIZYFLOW_HEATMAP_MAX_MEMORY_RECORDS=20000
DIZYFLOW_HEATMAP_MAX_DISK_MB=64
DIZYFLOW_ARCHIVE_SYMBOLS=BTC_USDT
ALLOW_TEST_PLAINTEXT_PASSWORDS=false

ROB_NAME=Rob
ROB_EMAIL=rob@example.com
ROB_PASSWORD_HASH=generated-salt:generated-scrypt-hash
ROB_PASSWORD=

FRIEND_NAME=Nick
FRIEND_EMAIL=friend@example.com
FRIEND_PASSWORD_HASH=generated-salt:generated-scrypt-hash
FRIEND_PASSWORD=
